<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Files.App.Linux</RootNamespace>
    <AssemblyName>files</AssemblyName>
    <Product>Files</Product>
    <Version>1.0.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon />
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <!--  The IDataObject clipboard/drag-and-drop API is marked obsolete in Avalonia 11.3 but is the one that carries
          the X11 file formats (x-special/gnome-copied-files, text/uri-list) used by other file managers.  -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--  Reuse the Windows app's translations  -->
  <ItemGroup>
    <None Include="..\Files.App\Strings\**\Resources.resw" Link="Strings\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentIcons.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Files.App.Linux.Tests" />
  </ItemGroup>

</Project>
