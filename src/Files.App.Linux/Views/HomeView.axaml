<UserControl
	x:Class="Files.App.Linux.Views.HomeView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="using:Files.App.Linux.Controls"
	xmlns:ic="using:FluentIcons.Avalonia"
	xmlns:m="using:Files.App.Linux.Models"
	xmlns:v="using:Files.App.Linux.Views"
	xmlns:vm="using:Files.App.Linux.ViewModels"
	x:DataType="vm:ShellTabViewModel">

	<UserControl.Resources>
		<!--  Flat widget sections, as on the Windows Home page  -->
		<SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderBackground" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderBorderBrush" Color="Transparent" />
		<Thickness x:Key="ExpanderContentPadding">0,4,0,0</Thickness>
	</UserControl.Resources>

	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="20,12,20,24" Spacing="8">

			<!--  Quick access  -->
			<Expander
				Padding="0"
				HorizontalAlignment="Stretch"
				HorizontalContentAlignment="Stretch"
				IsExpanded="True">
				<Expander.Header>
					<TextBlock Classes="header" Text="{v:Loc QuickAccess, Quick access}" />
				</Expander.Header>
				<ItemsControl ItemsSource="{Binding Home.QuickAccess}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:QuickAccessCard">
							<Button
								Width="124"
								Height="112"
								Margin="0,0,8,8"
								Classes="card subtle"
								Click="OnQuickAccessClick"
								ToolTip.Tip="{Binding Path}">
								<Button.ContextMenu>
									<ContextMenu>
										<MenuItem Click="OnQuickAccessOpenInNewTab" Header="{v:Loc OpenInNewTab, Open in new tab}" />
										<MenuItem Click="OnQuickAccessUnpin" Header="{v:Loc UnpinFolderFromSidebar, Unpin from Sidebar}" />
									</ContextMenu>
								</Button.ContextMenu>
								<StackPanel VerticalAlignment="Center" Spacing="10">
									<Panel Width="48" Height="48" HorizontalAlignment="Center">
										<ContentControl Content="{Binding Converter={x:Static v:HomeView.FolderIconConverter}}" />
										<ic:SymbolIcon
											Margin="0,10,0,0"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											FontSize="18"
											Foreground="{Binding Brush}"
											IconVariant="Filled"
											IsVisible="{Binding ShowBadge}"
											Symbol="{Binding Icon}" />
									</Panel>
									<TextBlock
										HorizontalAlignment="Center"
										FontSize="12"
										Text="{Binding Name}"
										TextTrimming="CharacterEllipsis" />
								</StackPanel>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Expander>

			<!--  Drives  -->
			<Expander
				Padding="0"
				HorizontalAlignment="Stretch"
				HorizontalContentAlignment="Stretch"
				IsExpanded="True">
				<Expander.Header>
					<TextBlock Classes="header" Text="{v:Loc Drives, Drives}" />
				</Expander.Header>
				<ItemsControl ItemsSource="{Binding Home.Drives}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:DriveCard">
							<Button
								Width="260"
								Height="80"
								Margin="0,0,8,8"
								Padding="12"
								Classes="card subtle"
								Click="OnDriveClick"
								ToolTip.Tip="{Binding Path}">
								<Grid ColumnDefinitions="Auto,*">
									<ic:SymbolIcon
										Margin="4,0,14,0"
										VerticalAlignment="Center"
										FontSize="32"
										Foreground="{DynamicResource App.Theme.SecondaryTextBrush}"
										Symbol="{Binding Icon}" />
									<StackPanel
										Grid.Column="1"
										VerticalAlignment="Center"
										Spacing="4">
										<TextBlock
											FontSize="13"
											Text="{Binding Name}"
											TextTrimming="CharacterEllipsis" />
										<ProgressBar
											Height="4"
											MinWidth="0"
											Classes.low="{Binding IsLowOnSpace}"
											Maximum="100"
											Value="{Binding UsedPercent}" />
										<TextBlock
											Classes="secondary"
											FontSize="12"
											Text="{Binding SpaceText}"
											TextTrimming="CharacterEllipsis" />
									</StackPanel>
								</Grid>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Expander>

			<!--  Recent files  -->
			<Expander
				Padding="0"
				HorizontalAlignment="Stretch"
				HorizontalContentAlignment="Stretch"
				IsExpanded="True">
				<Expander.Header>
					<TextBlock Classes="header" Text="{v:Loc RecentFiles, Recent files}" />
				</Expander.Header>
				<Panel>
					<TextBlock
						Margin="4,8"
						Classes="secondary"
						IsVisible="{Binding !Home.HasRecentFiles}"
						Text="{v:Loc RecentItemsEmpty, No recent files}" />
					<ItemsControl IsVisible="{Binding Home.HasRecentFiles}" ItemsSource="{Binding Home.RecentFiles}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="m:FileItem">
								<Button
									Height="36"
									Padding="8,0"
									HorizontalAlignment="Stretch"
									HorizontalContentAlignment="Stretch"
									Classes="subtle"
									Click="OnRecentClick"
									ToolTip.Tip="{Binding FullPath}">
									<Button.ContextMenu>
										<ContextMenu>
											<MenuItem Click="OnRecentOpenLocation" Header="{v:Loc OpenFileLocation, Open file location}" />
										</ContextMenu>
									</Button.ContextMenu>
									<Grid ColumnDefinitions="Auto,*,Auto">
										<c:ItemIcon
											Margin="0,0,12,0"
											IconSize="20"
											Item="{Binding}" />
										<TextBlock
											Grid.Column="1"
											VerticalAlignment="Center"
											FontSize="13"
											Text="{Binding Name}"
											TextTrimming="CharacterEllipsis" />
										<TextBlock
											Grid.Column="2"
											Margin="12,0,0,0"
											VerticalAlignment="Center"
											Classes="secondary"
											FontSize="12"
											Text="{Binding ModifiedText}" />
									</Grid>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Panel>
			</Expander>
		</StackPanel>
	</ScrollViewer>
</UserControl>
