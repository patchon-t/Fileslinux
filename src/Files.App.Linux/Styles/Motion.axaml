<!--
	Windows (WinUI / Fluent) motion for the Linux port. Loaded only while animations are enabled
	in Settings (App.ApplyMotion), so turning animations off removes every style below.
	Timings and curves match WinUI; see docs/linux-animations.md.
	  Faster 83 ms  (ControlFasterAnimationDuration)  - hover/press color changes
	  Fast   167 ms (ControlFastAnimationDuration)    - selection pill, tooltips, new tabs
	  Normal 250 ms (ControlNormalAnimationDuration)  - menus, flyouts, progress
	  Decelerate 0.1,0.9,0.2,1.0 / FastOutSlowIn 0,0,0,1
-->
<Styles
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ic="using:FluentIcons.Avalonia">

	<!--  Hover and press: background color fades in 83 ms, like every WinUI control  -->
	<Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter, ToggleButton /template/ ContentPresenter#PART_ContentPresenter, DropDownButton /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.083" />
				<BrushTransition Property="BorderBrush" Duration="0:0:0.083" />
			</Transitions>
		</Setter>
	</Style>
	<Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.083" />
			</Transitions>
		</Setter>
	</Style>

	<!--  Tab close buttons fade in on hover  -->
	<Style Selector="ListBox.tabs ListBoxItem Button.tabclose">
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Opacity" Duration="0:0:0.083" />
			</Transitions>
		</Setter>
	</Style>

	<!--  Sidebar selection pill stretches in (NavigationView selection indicator)  -->
	<Style Selector="ListBoxItem:selected Border.pill">
		<Style.Animations>
			<Animation Easing="0,0,0,1" FillMode="Both" Duration="0:0:0.167">
				<KeyFrame Cue="0%">
					<Setter Property="ScaleTransform.ScaleY" Value="0" />
				</KeyFrame>
				<KeyFrame Cue="100%">
					<Setter Property="ScaleTransform.ScaleY" Value="1" />
				</KeyFrame>
			</Animation>
		</Style.Animations>
	</Style>

	<!--  New tabs fade and rise in (TabView)  -->
	<Style Selector="ListBox.tabs ListBoxItem">
		<Style.Animations>
			<Animation Easing="0.1,0.9,0.2,1.0" FillMode="Both" Duration="0:0:0.25">
				<KeyFrame Cue="0%">
					<Setter Property="Opacity" Value="0" />
					<Setter Property="TranslateTransform.Y" Value="8" />
				</KeyFrame>
				<KeyFrame Cue="100%">
					<Setter Property="Opacity" Value="1" />
					<Setter Property="TranslateTransform.Y" Value="0" />
				</KeyFrame>
			</Animation>
		</Style.Animations>
	</Style>

	<!--  Menus and flyouts slide down and fade in (MenuFlyout / Flyout open)  -->
	<Style Selector="MenuFlyoutPresenter, ContextMenu, FlyoutPresenter">
		<Style.Animations>
			<Animation Easing="0.1,0.9,0.2,1.0" FillMode="Both" Duration="0:0:0.25">
				<KeyFrame Cue="0%">
					<Setter Property="Opacity" Value="0" />
					<Setter Property="TranslateTransform.Y" Value="-12" />
				</KeyFrame>
				<KeyFrame Cue="100%">
					<Setter Property="Opacity" Value="1" />
					<Setter Property="TranslateTransform.Y" Value="0" />
				</KeyFrame>
			</Animation>
		</Style.Animations>
	</Style>

	<!--  Tooltips fade in  -->
	<Style Selector="ToolTip">
		<Style.Animations>
			<Animation Easing="0,0,0,1" FillMode="Both" Duration="0:0:0.167">
				<KeyFrame Cue="0%">
					<Setter Property="Opacity" Value="0" />
				</KeyFrame>
				<KeyFrame Cue="100%">
					<Setter Property="Opacity" Value="1" />
				</KeyFrame>
			</Animation>
		</Style.Animations>
	</Style>

	<!--  Progress moves smoothly instead of jumping (status center, drive usage)  -->
	<Style Selector="ProgressBar">
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Easing="0,0,0,1" Property="Value" Duration="0:0:0.25" />
			</Transitions>
		</Setter>
	</Style>

	<!--
		Animated icons (WinUI AnimatedIcon). The Windows app animates the back arrow (AnimatedBackVisualSource),
		the sidebar button (AnimatedGlobalNavigationButtonVisualSource), the settings gear (AnimatedSettingsVisualSource),
		expand/collapse chevrons and drop-down chevrons. Same idea here: the icon reacts to hover and press.
	-->
	<Style Selector="Button.anim-back ic|SymbolIcon, Button.anim-forward ic|SymbolIcon, Button.anim-up ic|SymbolIcon, Button.anim-nav ic|SymbolIcon, Button.anim-settings ic|SymbolIcon, ic|SymbolIcon.sectionchevron, Button.crumbchevron ic|SymbolIcon">
		<Setter Property="Transitions">
			<Transitions>
				<TransformOperationsTransition Easing="0.1,0.9,0.2,1.0" Property="RenderTransform" Duration="0:0:0.25" />
			</Transitions>
		</Setter>
	</Style>
	<Style Selector="Button.anim-back ic|SymbolIcon, Button.anim-forward ic|SymbolIcon, Button.anim-up ic|SymbolIcon, Button.anim-nav ic|SymbolIcon, Button.anim-settings ic|SymbolIcon">
		<Setter Property="RenderTransform" Value="translate(0px, 0px)" />
	</Style>

	<!--  Back / forward / up: the arrow nudges the way it points  -->
	<Style Selector="Button.anim-back:pointerover ic|SymbolIcon">
		<Setter Property="RenderTransform" Value="translate(-1px, 0px)" />
	</Style>
	<Style Selector="Button.anim-back:pressed ic|SymbolIcon">
		<Setter Property="RenderTransform" Value="translate(-4px, 0px)" />
	</Style>
	<Style Selector="Button.anim-forward:pointerover ic|SymbolIcon">
		<Setter Property="RenderTransform" Value="translate(1px, 0px)" />
	</Style>
	<Style Selector="Button.anim-forward:pressed ic|SymbolIcon">
		<Setter Property="RenderTransform" Value="translate(4px, 0px)" />
	</Style>
	<Style Selector="Button.anim-up:pointerover ic|SymbolIcon">
		<Setter Property="RenderTransform" Value="translate(0px, -1px)" />
	</Style>
	<Style Selector="Button.anim-up:pressed ic|SymbolIcon">
		<Setter Property="RenderTransform" Value="translate(0px, -4px)" />
	</Style>

	<!--  Sidebar button: the icon squeezes when pressed  -->
	<Style Selector="Button.anim-nav:pressed ic|SymbolIcon">
		<Setter Property="RenderTransform" Value="scale(0.75, 1)" />
	</Style>

	<!--  Settings: the gear turns on hover and a bit more when pressed  -->
	<Style Selector="Button.anim-settings:pointerover ic|SymbolIcon">
		<Setter Property="RenderTransform" Value="rotate(60deg)" />
	</Style>
	<Style Selector="Button.anim-settings:pressed ic|SymbolIcon">
		<Setter Property="RenderTransform" Value="rotate(120deg)" />
	</Style>

	<!--  Drop-down chevrons bounce down when pressed  -->
	<Style Selector="DropDownButton /template/ PathIcon#DropDownGlyph">
		<Setter Property="RenderTransform" Value="translate(0px, 0px)" />
		<Setter Property="Transitions">
			<Transitions>
				<TransformOperationsTransition Easing="0.1,0.9,0.2,1.0" Property="RenderTransform" Duration="0:0:0.167" />
			</Transitions>
		</Setter>
	</Style>
	<Style Selector="DropDownButton:pressed /template/ PathIcon#DropDownGlyph">
		<Setter Property="RenderTransform" Value="translate(0px, 3px)" />
	</Style>
</Styles>
